{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-sumimoto/design-anatomy/schema/anatomy.schema.json",
  "title": "Design Anatomy",
  "description": "Structural breakdown of a flat design image (banner, poster, thumbnail, UI, LP section...) into role-labelled elements.",
  "type": "object",
  "required": ["version", "source", "elements"],
  "properties": {
    "version": { "const": "0.1" },
    "summary": { "type": "string", "description": "One line: what this design is and its intent." },
    "source": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "path": { "type": "string", "description": "Image path, relative to this JSON file." },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["banner", "poster", "thumbnail", "social", "ui", "lp", "flyer", "other"] }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered by reading order (the order a viewer's eye follows). Numbering in the sheet follows this order.",
      "items": {
        "type": "object",
        "required": ["role", "bbox"],
        "properties": {
          "id": { "type": "string" },
          "role": {
            "enum": [
              "background",
              "headline", "subheadline", "body", "caption", "price", "date", "label", "copy", "other-text",
              "eyebrow", "heading", "info", "list", "note", "credit", "hashtag", "handle", "rating",
              "illustration", "photo", "product", "icon", "character", "other-image", "qr", "avatar", "map",
              "cta", "button", "link", "input", "chip",
              "logo",
              "badge", "decoration", "shape", "divider",
              "frame", "container", "card", "nav", "header", "statusbar", "tabbar",
              "other"
            ]
          },
          "label": { "type": "string", "description": "Optional display name overriding the role (any language)." },
          "bbox": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "description": "Source-image pixels, top-left origin.",
            "properties": {
              "x": { "type": "number" }, "y": { "type": "number" },
              "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "z": { "type": "integer", "description": "Stacking order. Background defaults to -1, others 0." },
          "content": { "type": "string", "description": "Text roles: the exact text (\\n for line breaks). Image roles: a short description of what is depicted." },
          "lines": { "type": "integer", "minimum": 1, "description": "Number of text lines (drawn as bars in the wireframe)." },
          "parent": { "type": "string", "description": "id of a container element, if nested." },
          "style": {
            "type": "object",
            "description": "Optional observed style hints.",
            "properties": {
              "color": { "type": "string" },
              "background": { "type": "string" },
              "fontWeight": { "type": "string" },
              "fontFamilyGuess": { "type": "string" },
              "align": { "enum": ["left", "center", "right", "justify"] }
            },
            "additionalProperties": true
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "enum": ["ocr", "vision", "ocr+vision"], "description": "How the bbox was obtained." }
        }
      }
    },
    "palette": { "type": "array", "items": { "type": "string" }, "description": "Dominant colors (hex)." },
    "notes": { "type": "array", "items": { "type": "string" }, "description": "Layout observations: grid, hierarchy, visual flow, uncertainties." }
  }
}
